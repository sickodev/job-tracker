# ==============================================================================
# Supabase & Prisma PostgreSQL Configuration
# ==============================================================================
# 1. Obtain these from your Supabase Dashboard: Settings -> API & Database
# 2. Paste your project URL, anon public key, and PostgreSQL connection URIs below:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase PostgreSQL database connections for Prisma ORM
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"
